{
  "name": "vak-projection",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "playground": "node --disable-warning=ExperimentalWarning playground/server.ts",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.ts",
    "bench:gate": "node --disable-warning=ExperimentalWarning scripts/bench.ts gate ollama:qwen3.5:4b-mlx --runs 2",
    "telegram": "node --disable-warning=ExperimentalWarning packages/telegram/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
